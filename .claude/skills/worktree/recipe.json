{
  "$schema": "https://raw.githubusercontent.com/Edvantage26/ai1/main/schema/worktree-recipe.schema.json",
  "version": 1,
  "copy": [".claude/settings.local.json"],
  "commands": {
    "test": "npm test",
    "okf": "node bin/ai1 okf validate .ai1/okf --strict",
    "validate": "claude plugin validate .",
    "pre-finish": ["npm test", "node bin/ai1 okf validate .ai1/okf --strict"]
  },
  "finish": { "allow_merge": false, "dirty_base_paths_ok": [".ai1/okf/"] }
}
