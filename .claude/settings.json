{
  "enabledPlugins": {
    "ai1@ai1": true
  },
  "extraKnownMarketplaces": {
    "ai1": {
      "source": {
        "source": "github",
        "repo": "Edvantage26/ai1"
      }
    }
  },
  "permissions": {
    "deny": [
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)"
    ]
  }
}
