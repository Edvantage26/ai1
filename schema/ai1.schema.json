                },
                "deployCommands": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Regexes of this repo's own deploy commands (matched against each simple command of a Bash call); a match counts as a release to production."
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "local-sync-start": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "local-sync-stop": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "routine-notice": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "rules": {
      "type": "array",
      "default": [],
      "description": "The repo's own guard rules, applied by the repo-rules module (feature danger) before shell commands and file edits. A rule that does not validate is ignored with a notice at session start.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "on",
          "action",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Unique kebab-case id, shown in the reason."
          },
          "on": {
            "enum": [
              "bash",
              "edit",
              "mcp"
            ],
            "description": "bash: each simple command of a shell call; edit: Edit/Write/MultiEdit/NotebookEdit; mcp: MCP tool calls (tool against the tool name, pattern against its JSON input)."
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "JavaScript regular expression: tested against each simple command (bash) or the new text (edit). Required for bash rules."
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Edit rules only: globs of the files the rule covers (default: all)."
          },
          "action": {
            "enum": [
              "ask",
              "deny"
            ],
            "description": "ask: the person confirms; deny: refused."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Why, and what to do instead."
          },
          "flags": {
            "type": "string",
            "pattern": "^[imsu]*$",
            "description": "Regular expression flags for pattern and tool: i (case-insensitive), m, s, u."
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "mcp rules: regular expression matched against the MCP tool name (e.g. ^mcp__postgres__)."
          }
        }
      }
    },
    "related": {
      "type": "array",
      "default": [],
      "description": "Other repositories whose knowledge this one needs: where their knowledge bundle is and what they own. Each fact lives in the repository that changes it; this repo only links to it. Read by okf-index (listed at session start) and okf-file-context (a read of another repository with a bundle). An entry that does not validate is ignored with a notice at session start.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "remote"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Short name of the repository."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Where it is usually cloned, relative to this repo's root (e.g. ../other-repo) or absolute."
          },
          "remote": {
            "type": "string",
            "minLength": 1,
            "description": "Its remote as owner/name (matched against the origin URL of a clone)."
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "description": "The branch whose knowledge counts (e.g. main, develop)."
          },
          "bundle": {
            "type": "string",
            "minLength": 1,
            "description": "Its knowledge bundle folder; default .ai1/okf, else .okf."
          },
          "read_without_clone": {
            "type": "string",
            "minLength": 1,
            "description": "A command that prints its bundle index.md when it is not cloned here."
          },
          "owns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "What it owns that this repo uses (a contract, a schema...)."
          }
        }
      }
    }
  }
}
