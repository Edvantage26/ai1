{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edvantage26/ai1/main/schema/ai1.schema.json",
  "title": "ai1 repo configuration (.ai1/config.json)",
  "description": "Per-repo contract read by the ai1 hooks (.ai1/config.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Contract version."
    },
    "features": {
      "type": "object",
      "description": "Features enabled in this repo. Omitted features use their default (okf, danger, craft and verify: on, lanes, worktrees, design and proposals: off).",
      "additionalProperties": false,
      "properties": {
        "okf": {
          "type": "boolean",
          "default": true,
          "description": "OKF project knowledge: index at session start, upkeep reminder at stop, /ai1:okf-maintain-knowledge and /ai1:okf-validate-bundle skills."
        },
        "danger": {
          "type": "boolean",
          "default": true,
          "description": "Confirm or refuse destructive shell commands."
        },
        "craft": {
          "type": "boolean",
          "default": true,
          "description": "Code craft rules at session start: simplicity, surgical changes, reuse before writing, proposed refactors, self-explanatory names."
        },
        "lanes": {
          "type": "boolean",
          "default": false,
          "description": "Work lanes: quick, plan or deep by task size; deep designs need the person's approval before code edits (/ai1:lanes-design-before-code)."
        },
        "worktrees": {
          "type": "boolean",
          "default": false,
          "description": "A worktree per change (any edit to the repo files, created before the first edit), made with the project recipe planned once with /ai1:worktrees-plan-recipe (.claude/skills/worktree/); the agent keeps saying which worktree it works in."
        },
        "design": {
          "type": "boolean",
          "default": false,
          "description": "UI design rules at session start and deterministic design checks on every edited UI file (design-detect)."
        },
        "verify": {
          "type": "boolean",
          "default": true,
          "description": "Verification gate: no finishing while code changed after the last passing run of the verify commands."
        },
        "proposals": {
          "type": "boolean",
          "default": false,
          "description": "Proposals: undecided changes and future features in .ai1/proposals/, created only when the person asks or accepts an offer; open ones listed at session start, related ones recalled per message, consistency and bundle citation checked at stop (/ai1:proposals-write, ai1 proposals)."
        },
        "rfc": {
          "type": "boolean",
          "deprecated": true,
          "description": "Renamed to proposals in v0.18.0; ignored with a notice at session start. /ai1:core-setup-repo (ai1 init) migrates it."
        }
      }
    },
    "trunk": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Protected branch."
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Commands that must pass before the agent calls a change done."
    },
    "knowledge": {
      "deprecated": true,
      "description": "Retired in v0.16.0: the OKF knowledge bundle is always .ai1/okf/. A value of .ai1/okf is ignored; any other value is ignored with a notice at session start, and ai1 init moves that bundle to .ai1/okf/ and removes the setting."
    },
    "modules": {
      "type": "object",
      "description": "Per-module switch (true/false) or options object (with optional enabled).",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "properties": {
        "brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "danger": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "git-skip-hooks",
                      "git-reset-hard",
                      "git-force-push",
                      "git-clean",
                      "git-discard-changes",
                      "git-worktree-remove",
                      "ai1-worktree-drop",
                      "ai1-worktree-finish",
                      "ai1-proposals-new",
                      "rm-recursive-force",
                      "find-delete",
                      "file-truncate",
                      "sql-destructive",
                      "docker-destructive",
                      "disk-destroy"
                    ]
                  }
                }
              }
            }
          ]
        },
        "okf-index": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-upkeep": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-recall": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-claude-md": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-file-context": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "craft-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-reminder": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-approval": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-gate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-escalate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_files": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 6,
                  "description": "Files changed in the session, without a plan, before asking."
                },
                "max_lines": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 300,
                  "description": "Lines changed (added + removed) in the session, without a plan, before asking."
                }
              }
            }
          ]
        },
        "design-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "design-detect": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "description": "Design rule ids to switch off in this repo.",
                  "items": {
                    "enum": [
                      "overused-font",
                      "gradient-text",
                      "ai-color-palette",
                      "side-tab",
                      "dark-glow",
                      "bounce-easing",
                      "pulsing-dot",
                      "marquee",
                      "kicker-above-heading",
                      "icon-tile-stack",
                      "italic-serif-display",
                      "cream-palette",
                      "marketing-buzzword",
                      "em-dash-overuse",
                      "theater-slop-phrase",
                      "repeating-stripes-gradient",
                      "codex-grid-background",
                      "hard-offset-shadow",
                      "organic-clip-path",
                      "extreme-negative-tracking",
                      "broken-image",
                      "skipped-heading",
                      "gray-on-color",
                      "low-contrast",
                      "tiny-text",
                      "justified-text"
                    ]
                  }
                }
              }
            }
          ]
        },
        "verify-gate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Globs of changed files that do not need verification, added to the defaults (*.md, .claude/**, .ai1/**, the knowledge bundle .ai1/okf/**)."
                }
              }
            }
          ]
        },
        "proposals-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "proposals-recall": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "proposals-upkeep": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "rfc-brief": {
          "deprecated": true,
          "description": "Renamed to proposals-brief in v0.18.0; ignored with a notice at session start."
        },
        "rfc-recall": {
          "deprecated": true,
          "description": "Renamed to proposals-recall in v0.18.0; ignored with a notice at session start."
        },
        "rfc-upkeep": {
          "deprecated": true,
          "description": "Renamed to proposals-upkeep in v0.18.0; ignored with a notice at session start."
        }
      }
    }
  }
}
