{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edvantage26/ai1/main/schema/ai1.schema.json",
  "title": "ai1 repo configuration (.ai1/config.json)",
  "description": "Per-repo contract read by the ai1 hooks (.ai1/config.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Contract version."
    },
    "features": {
      "type": "object",
      "description": "Features enabled in this repo. Omitted features use their default (okf, danger, craft and verify: on, sizing, worktrees, design, storyboard, later and reuse: off).",
      "additionalProperties": false,
      "properties": {
        "okf": {
          "type": "boolean",
          "default": true,
          "description": "OKF project knowledge: index at session start, upkeep reminder at stop, /ai1:okf-maintain-knowledge and /ai1:okf-validate-bundle skills."
        },
        "danger": {
          "type": "boolean",
          "default": true,
          "description": "Confirm or refuse destructive shell commands."
        },
        "craft": {
          "type": "boolean",
          "default": true,
          "description": "Code craft rules at session start: simplicity, surgical changes, reuse before writing, proposed refactors, self-explanatory names."
        },
        "sizing": {
          "type": "boolean",
          "default": false,
          "description": "Task sizing: quick, plan or deep by task size; deep designs need the person's approval before code edits (/ai1:sizing-design-before-code)."
        },
        "worktrees": {
          "type": "boolean",
          "default": false,
          "description": "A worktree per change (any edit to the repo files, created before the first edit), made with the project recipe planned once with /ai1:worktrees-plan-recipe (.claude/skills/worktree/); the agent keeps saying which worktree it works in."
        },
        "design": {
          "type": "boolean",
          "default": false,
          "description": "UI design rules at session start and deterministic design checks on every edited UI file (design-detect)."
        },
        "storyboard": {
          "type": "boolean",
          "default": false,
          "description": "Visual storyboard of the user flow after UI changes: storyboard (HTML, PDF) with before/after, served locally and saved to the person's chosen folder; reminder at stop (/ai1:storyboard-record-flow, ai1 storyboard)."
        },
        "verify": {
          "type": "boolean",
          "default": true,
          "description": "Verification gate: no finishing while code changed after the last passing run of the verify commands."
        },
        "later": {
          "type": "boolean",
          "default": false,
          "description": "Later: undecided changes and future features noted down for later in .ai1/later/, only when the person asks or picks it in an offer; open ones listed at session start, related ones recalled per message, consistency and bundle citation checked at stop (/ai1:later-write, ai1 later)."
        },
        "reuse": {
          "type": "boolean",
          "default": false,
          "description": "Reuse: after a task with real work the agent judges whether it will recur in this repo, searches this repo's own past sessions and project skills/commands/MCP servers (ai1 reuse search) and proposes encapsulating it or completing an existing piece; built only on a yes (/ai1:reuse-encapsulate); a no is kept in .ai1/reuse.json."
        },
        "proposals": {
          "type": "boolean",
          "deprecated": true,
          "description": "Renamed to later in v0.25.0; ignored with a notice at session start. /ai1:core-setup-repo (ai1 init) migrates it."
        },
        "rfc": {
          "type": "boolean",
          "deprecated": true,
          "description": "Renamed to proposals in v0.18.0 and to later in v0.25.0; ignored with a notice at session start. /ai1:core-setup-repo (ai1 init) migrates it."
        }
      }
    },
    "trunk": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Protected branch."
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Commands that must pass before the agent calls a change done."
    },
    "knowledge": {
      "deprecated": true,
      "description": "Retired in v0.16.0: the OKF knowledge bundle is always .ai1/okf/. A value of .ai1/okf is ignored; any other value is ignored with a notice at session start, and ai1 init moves that bundle to .ai1/okf/ and removes the setting."
    },
    "modules": {
      "type": "object",
      "description": "Per-module switch (true/false) or options object (with optional enabled).",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "properties": {
        "brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "issue-offer": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "danger": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "git-skip-hooks",
                      "git-reset-hard",
                      "git-force-push",
                      "git-clean",
                      "git-discard-changes",
                      "git-worktree-remove",
                      "ai1-worktree-drop",
                      "rm-recursive-force",
                      "find-delete",
                      "file-truncate",
                      "sql-destructive",
                      "docker-destructive",
                      "disk-destroy"
                    ]
                  }
                }
              }
            }
          ]
        },
        "config-guard": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "repo-rules": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-index": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-upkeep": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-recall": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-claude-md": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-file-context": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "craft-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-reminder": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-recipe-offer": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sizing-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sizing-approval": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sizing-gate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sizing-escalate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_files": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 6,
                  "description": "Files changed in the session, without a plan, before asking."
                },
                "max_lines": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 300,
                  "description": "Lines changed (added + removed) in the session, without a plan, before asking."
                }
              }
            }
          ]
        },
        "storyboard-reminder": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore": {
                  "type": "array",
                  "description": "Globs of UI files that never need a storyboard (e.g. \"src/emails/**\").",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "design-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "design-detect": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "description": "Design rule ids to switch off in this repo.",
                  "items": {
                    "enum": [
                      "overused-font",
                      "gradient-text",
                      "ai-color-palette",
                      "side-tab",
                      "dark-glow",
                      "bounce-easing",
                      "pulsing-dot",
                      "marquee",
                      "kicker-above-heading",
                      "icon-tile-stack",
                      "italic-serif-display",
                      "cream-palette",
                      "marketing-buzzword",
                      "em-dash-overuse",
                      "theater-slop-phrase",
                      "repeating-stripes-gradient",
                      "codex-grid-background",
                      "hard-offset-shadow",
                      "organic-clip-path",
                      "extreme-negative-tracking",
                      "broken-image",
                      "skipped-heading",
                      "gray-on-color",
                      "low-contrast",
                      "tiny-text",
                      "justified-text"
                    ]
                  }
                }
              }
            }
          ]
        },
        "verify-gate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Globs of changed files that do not need verification, added to the defaults (*.md, .claude/**, .ai1/**, the knowledge bundle .ai1/okf/**)."
                }
              }
            }
          ]
        },
        "test-guard": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "test_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Globs of test files, replacing the defaults (*.test.*, *.spec.*, test_*.py, *_test.py, *_test.go, **/test/**, **/tests/**, **/__tests__/**)."
                },
                "check_config_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Globs of dedicated check config files (lint, format, types, test runner), replacing the defaults (.eslintrc*, eslint.config.*, .prettierrc*, tsconfig*.json, ruff.toml, mypy.ini, pytest.ini, .golangci.yml...). The checkers' sections of pyproject.toml, setup.cfg, tox.ini and package.json are always checked."
                },
                "ignore_rules": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "test-skip-added",
                      "test-assertions-removed",
                      "test-file-emptied",
                      "test-file-removed",
                      "test-shell-edit",
                      "check-config-changed"
                    ]
                  }
                }
              }
            }
          ]
        },
        "tool-loop": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "repeat_threshold": {
                  "type": "integer",
                  "minimum": 2,
                  "default": 5,
                  "description": "Identical tool calls in a row (same tool, same input) before the agent is told it is going round in circles."
                }
              }
            }
          ]
        },
        "fix-loop": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_failed_attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 3,
                  "description": "Failed fix attempts in a row (a test still failing after an edit) before the agent is told to stop and go back to the root cause."
                },
                "test_commands": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Regular expressions for test commands, tested against each simple command; replace the built-in runner list (npm/pnpm/yarn/bun test, node --test, pytest, unittest, jest, vitest, mocha, go/cargo/bun/deno test). Verify commands always count."
                },
                "ignore_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Globs of files whose edits are not fix attempts (docs, .claude and .ai1 are already left out)."
                }
              }
            }
          ]
        },
        "reuse-check": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "minToolCalls": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 8,
                  "description": "Tool calls since the last reuse check before the agent is asked whether the work will recur."
                }
              }
            }
          ]
        },
        "later-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "later-recall": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "later-upkeep": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "proposals-brief": {
          "deprecated": true,
          "description": "Renamed to later-brief in v0.25.0; ignored with a notice at session start."
        },
        "proposals-recall": {
          "deprecated": true,
          "description": "Renamed to later-recall in v0.25.0; ignored with a notice at session start."
        },
        "proposals-upkeep": {
          "deprecated": true,
          "description": "Renamed to later-upkeep in v0.25.0; ignored with a notice at session start."
        },
        "rfc-brief": {
          "deprecated": true,
          "description": "Renamed to proposals-brief in v0.18.0 and to later-brief in v0.25.0; ignored with a notice at session start."
        },
        "rfc-recall": {
          "deprecated": true,
          "description": "Renamed to proposals-recall in v0.18.0 and to later-recall in v0.25.0; ignored with a notice at session start."
        },
        "rfc-upkeep": {
          "deprecated": true,
          "description": "Renamed to proposals-upkeep in v0.18.0 and to later-upkeep in v0.25.0; ignored with a notice at session start."
        }
      }
    },
    "rules": {
      "type": "array",
      "default": [],
      "description": "The repo's own guard rules, applied by the repo-rules module (feature danger) before shell commands and file edits. A rule that does not validate is ignored with a notice at session start.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "on",
          "action",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Unique kebab-case id, shown in the reason."
          },
          "on": {
            "enum": [
              "bash",
              "edit"
            ],
            "description": "bash: each simple command of a shell call; edit: Edit/Write/MultiEdit/NotebookEdit."
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "JavaScript regular expression: tested against each simple command (bash) or the new text (edit). Required for bash rules."
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Edit rules only: globs of the files the rule covers (default: all)."
          },
          "action": {
            "enum": [
              "ask",
              "deny"
            ],
            "description": "ask: the person confirms; deny: refused."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Why, and what to do instead."
          }
        }
      }
    }
  }
}
