{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edvantage26/ai1/main/schema/ai1.schema.json",
  "title": "ai1 repo configuration (.ai1/config.json)",
  "description": "Per-repo contract read by the ai1 hooks (.ai1/config.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "enum": [
        1,
        2
      ],
      "description": "Contract version. 2: every feature is on unless set to false here (opt-out). 1: written by ai1 before v0.36.0, when init listed every feature; a session start migrates it to 2, dropping the false values."
    },
    "features": {
      "type": "object",
      "description": "Features switched off in this repo (false). Every feature is on unless set to false here; true is accepted and changes nothing.",
      "additionalProperties": false,
      "properties": {
        "okf": {
          "type": "boolean",
          "default": true,
          "description": "OKF project knowledge: index at session start, upkeep reminder at stop, /ai1:okf-maintain-knowledge and /ai1:okf-validate-bundle skills."
        },
        "danger": {
          "type": "boolean",
          "default": true,
          "description": "Confirm or refuse destructive shell commands."
        },
        "craft": {
          "type": "boolean",
          "default": true,
          "description": "Code craft rules at session start: simplicity, surgical changes, reuse before writing, proposed refactors, self-explanatory names."
        },
        "sizing": {
          "type": "boolean",
          "default": true,
          "description": "Task sizing: quick, plan or deep by task size; deep designs need the person's approval before code edits (/ai1:sizing-design-before-code)."
        },
        "worktrees": {
          "type": "boolean",
          "default": true,
          "description": "A worktree per change (any edit to the repo files, created before the first edit), made with the project recipe planned once with /ai1:worktrees-plan-recipe (.claude/skills/worktree/); the agent keeps saying which worktree it works in."
        },
        "design": {
          "type": "boolean",
          "default": true,
          "description": "UI design rules at session start, deterministic design checks on every edited UI file (design-detect), and the usability review of a flow (/ai1:design-review-usability)."
        },
        "storyboard": {
          "type": "boolean",
          "default": true,
          "description": "Visual storyboard of the user flow after UI changes: storyboard (HTML, PDF) with before/after, served locally and saved to the person's chosen folder; reminder at stop (/ai1:storyboard-record-flow, ai1 storyboard)."
        },
        "verify": {
          "type": "boolean",
          "default": true,
          "description": "Verification gate: no finishing while code changed after the last passing run of the verify commands."
        },
        "delegate": {
          "type": "boolean",
          "default": true,
          "description": "Edits of this repository from a session launched elsewhere are refused and delegated to a session started here (ai1 delegate, /ai1:session-delegate-change)."
        },
        "later": {
          "type": "boolean",
          "default": true,
          "description": "Later: undecided changes and future features noted down for later in .ai1/later/, only when the person asks or picks it in an offer; open ones listed at session start, related ones recalled per message, consistency and bundle citation checked at stop (/ai1:later-write, ai1 later)."
        },
        "reuse": {
          "type": "boolean",
          "default": true,
          "description": "Reuse: after a task with real work the agent judges whether it will recur in this repo, searches this repo's own past sessions and project skills/commands/MCP servers (ai1 reuse search) and proposes encapsulating it or completing an existing piece; built only on a yes (/ai1:reuse-encapsulate); a no is kept in .ai1/reuse.json."
        },
        "proposals": {
          "type": "boolean",
          "deprecated": true,
          "description": "Renamed to later in v0.25.0; ignored with a notice at session start. /ai1:core-setup-repo (ai1 init) migrates it."
        },
        "rfc": {
          "type": "boolean",
          "deprecated": true,
          "description": "Renamed to proposals in v0.18.0 and to later in v0.25.0; ignored with a notice at session start. /ai1:core-setup-repo (ai1 init) migrates it."
        },
        "maintenance": {
          "type": "boolean",
          "default": true,
          "description": "Maintenance tasks for the people in maintainers (everyone without the list): CLAUDE.md drift, bundle health and periodic checks at session start; each person mutes a task with ai1 maintain off|snooze."
        },
        "watches": {
          "type": "boolean",
          "default": true,
          "description": "Follow what was shipped to production: watches in .ai1/watches/ (committed), each person's subscriptions and results in .ai1/local/, one line at session start with what changed; ai1 watch, /ai1:watches-follow-release."
        },
        "messages": {
          "type": "boolean",
          "default": true,
          "description": "Skill /ai1:messages-draft-message: drafts messages to the project's contacts (.ai1/okf/people/contacts.md) with the person's own relation and tone (.ai1/local/contacts.md); sends only through the person's own tool. ai1 contacts."
        },
        "routines": {
          "type": "boolean",
          "default": true,
          "description": "The person's periodic tasks (.ai1/local/routines.json) and ai1's built-in ones for maintainers, said in one line at session start and offered here or in a new conversation; ai1 routine, /ai1:routines-set-routine."
        }
      }
    },
    "trunk": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Protected branch."
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Commands that must pass before the agent calls a change done."
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "@"
      },
      "description": "Git emails (git config user.email, compared case-insensitively) of the people who maintain ai1 in this repo: they get the maintenance tasks. Without the list everyone does. A person can override it for themselves in .ai1/local/profile.json (role)."
    },
    "knowledge": {
      "deprecated": true,
      "description": "Retired in v0.16.0: the OKF knowledge bundle is always .ai1/okf/. A value of .ai1/okf is ignored; any other value is ignored with a notice at session start, and ai1 init moves that bundle to .ai1/okf/ and removes the setting."
    },
    "modules": {
      "type": "object",
      "description": "Per-module switch (true/false) or options object (with optional enabled).",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "properties": {
        "brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "issue-offer": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "issue-guard": {
          "oneOf": [
            {
              "type": "boolean"
