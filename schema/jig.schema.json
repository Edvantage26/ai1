{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edvantage26/jig/main/schema/jig.schema.json",
  "title": "jig repo configuration (.claude/jig.json)",
  "description": "Per-repo contract read by the jig hooks (.claude/jig.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Contract version."
    },
    "features": {
      "type": "object",
      "description": "Features enabled in this repo. Omitted features use their default (okf, danger, craft and verify: on, lanes and design: off).",
      "additionalProperties": false,
      "properties": {
        "okf": {
          "type": "boolean",
          "default": true,
          "description": "OKF project knowledge: index at session start, upkeep reminder at stop, /jig:okf and /jig:validate skills."
        },
        "danger": {
          "type": "boolean",
          "default": true,
          "description": "Confirm or refuse destructive shell commands."
        },
        "craft": {
          "type": "boolean",
          "default": true,
          "description": "Code craft rules at session start: simplicity, surgical changes, reuse before writing, proposed refactors, self-explanatory names."
        },
        "lanes": {
          "type": "boolean",
          "default": false,
          "description": "Work lanes: quick, plan or deep by task size; deep designs need the person's approval before code edits (/jig:deep)."
        },
        "worktrees": {
          "type": "boolean",
          "default": false,
          "description": "A worktree per significant change, made with the project recipe planned once with /jig:worktree (.claude/skills/worktree/); the agent keeps saying which worktree it works in."
        },
        "design": {
          "type": "boolean",
          "default": false,
          "description": "UI design rules at session start and deterministic design checks on every edited UI file (design-detect)."
        },
        "verify": {
          "type": "boolean",
          "default": true,
          "description": "Verification gate: no finishing while code changed after the last passing run of the verify commands."
        }
      }
    },
    "trunk": {
      "type": "string",
      "minLength": 1,
      "default": "main",
      "description": "Protected branch."
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Commands that must pass before the agent calls a change done."
    },
    "knowledge": {
      "type": [
        "string",
        "null"
      ],
      "default": ".okf",
      "description": "Path of the OKF knowledge bundle (default .okf)."
    },
    "modules": {
      "type": "object",
      "description": "Per-module switch (true/false) or options object (with optional enabled).",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "properties": {
        "brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "danger": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "git-skip-hooks",
                      "git-reset-hard",
                      "git-force-push",
                      "git-clean",
                      "git-discard-changes",
                      "git-worktree-remove",
                      "jig-worktree-drop",
                      "jig-worktree-finish",
                      "rm-recursive-force",
                      "sql-destructive",
                      "docker-destructive",
                      "disk-destroy"
                    ]
                  }
                }
              }
            }
          ]
        },
        "okf-index": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-upkeep": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "okf-recall": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "craft-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "worktree-reminder": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-approval": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-gate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lanes-escalate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "max_files": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 6,
                  "description": "Files changed in the session, without a plan, before asking."
                },
                "max_lines": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 300,
                  "description": "Lines changed (added + removed) in the session, without a plan, before asking."
                }
              }
            }
          ]
        },
        "design-brief": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "design-detect": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_rules": {
                  "type": "array",
                  "description": "Design rule ids to switch off in this repo.",
                  "items": {
                    "enum": [
                      "overused-font",
                      "gradient-text",
                      "ai-color-palette",
                      "side-tab",
                      "dark-glow",
                      "bounce-easing",
                      "pulsing-dot",
                      "marquee",
                      "kicker-above-heading",
                      "icon-tile-stack",
                      "italic-serif-display",
                      "cream-palette",
                      "marketing-buzzword",
                      "em-dash-overuse",
                      "theater-slop-phrase",
                      "repeating-stripes-gradient",
                      "codex-grid-background",
                      "hard-offset-shadow",
                      "organic-clip-path",
                      "extreme-negative-tracking",
                      "broken-image",
                      "skipped-heading",
                      "gray-on-color",
                      "low-contrast",
                      "tiny-text",
                      "justified-text"
                    ]
                  }
                }
              }
            }
          ]
        },
        "verify-gate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ignore_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Globs of changed files that do not need verification, added to the defaults (*.md, .claude/**, .jig/**, the knowledge bundle)."
                }
              }
            }
          ]
        }
      }
    }
  }
}
