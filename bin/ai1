#!/usr/bin/env node
// ai1 CLI. On the Bash PATH while the plugin is enabled.
//   ai1 status [--json]                         what this repo runs, and the available features
//   ai1 init --features okf,danger [--verify "npm test" ...] [--disable-plugins a@x,b@y] [--deny-credentials] [--report-errors ask|auto|off] [--json]
//   ai1 verify                                  run the repo's verify commands, stop at the first failure
//   ai1 step-done <slug> "<step>"               ai1 verify, then log the step in .ai1/work/<slug>/progress.md
//   ai1 plan-done <slug>                        close a plan: every behaviour scenario has its tagged test, then ai1 verify
//   ai1 later new <slug> [--idea] [--title "..."] create .ai1/later/NNNN-<slug>.md with the next number
//   ai1 later set <number> <status> [--by <n>]    change a later entry's status (dates, History line, index)
//   ai1 later index | ai1 later check            regenerate .ai1/later/README.md | report what is inconsistent
//   ai1 worktree <create|list|run|finish|drop>  worktrees from the project recipe (see src/cli/worktree-cli.mjs)
//   ai1 fork <full|brief|brief-path|host>        a new conversation from this one (see src/cli/fork-command.mjs)
//   ai1 issue <env|url>                          facts and a prefilled link for a bug report on ai1 (see src/cli/issue-command.mjs)
//   ai1 claude-md [--json]                       where the repo's CLAUDE.md files drift from the OKF bundle (src/okf/okf-claude-md-check.mjs)
//   ai1 log [--session <id>] [--since <hours>] [--all] [--json]  what ai1's modules decided here (or in every repo, --all) (src/cli/log-command.mjs)
//   ai1 skill-context <skill> | --list [--json]  a skill's project and user customization, injected when it loads (src/cli/skill-context-command.mjs)
//   ai1 storyboard <add|build|serve|stop|list|destination|save>  the storyboard of a visual change (see src/cli/storyboard-command.mjs)
// Run from anywhere inside the repo; files are written at the repo root.

import { findRepoRoot, describeRepo, setupRepo } from '../src/cli/setup-repo.mjs';
import { findMainCheckout } from '../src/core/project-roots.mjs';
import { runWorktreeCli, WORKTREE_USAGE } from '../src/cli/worktree-cli.mjs';
import { readVerifyCommands, runVerifyCommands, recordStepDone, describeScenarioCoverage, closePlan, findPlanRootFor } from '../src/cli/verify-run.mjs';
import { runLaterCommand, LATER_USAGE } from '../src/cli/later-command.mjs';
import { runStoryboardCommand, STORYBOARD_USAGE } from '../src/cli/storyboard-command.mjs';
import { runForkCommand, FORK_USAGE } from '../src/cli/fork-command.mjs';
import { runIssueCommand, ISSUE_USAGE } from '../src/cli/issue-command.mjs';
import { runLogCommand } from '../src/cli/log-command.mjs';
import { runSkillContextCommand, SKILL_CONTEXT_USAGE } from '../src/cli/skill-context-command.mjs';
import { describeOverlap } from '../src/core/plugin-overlaps.mjs';
import { resolveBundleDirectory, readBundleIndex } from '../src/okf/okf-bundle.mjs';
import { buildFileMap } from '../src/okf/okf-file-map.mjs';
import { checkClaudeMdFiles, formatClaudeMdReport } from '../src/okf/okf-claude-md-check.mjs';
import { KNOWLEDGE_BUNDLE_PATH } from '../src/core/config.mjs';
import { describeMigrationReports } from '../src/core/migrations.mjs';

const [commandName, ...commandArguments] = process.argv.slice(2);

function readOption(optionName) {
  const optionIndex = commandArguments.indexOf(optionName);
  return optionIndex >= 0 ? commandArguments[optionIndex + 1] : undefined;
}

function readRepeatedOption(optionName) {
  const optionValues = [];
  commandArguments.forEach((commandArgument, argumentIndex) => {
    if (commandArgument === optionName && commandArguments[argumentIndex + 1] !== undefined) optionValues.push(commandArguments[argumentIndex + 1]);
  });
  return optionValues;
}

const wantsJson = commandArguments.includes('--json');

const repoRoot = findRepoRoot(process.cwd());

try {
  if (commandName === 'skill-context') {
    // Runs inside a skill's `!` injection: never throws and always exits 0 (see the command).
    process.exitCode = runSkillContextCommand(commandArguments);
  } else if (commandName === 'worktree') {
    const cliResult = runWorktreeCli(process.cwd(), commandArguments);
    console.log(cliResult.output);
    process.exitCode = cliResult.exitCode;
  } else if (commandName === 'status') {
    const repoDescription = describeRepo(repoRoot);
    if (wantsJson) console.log(JSON.stringify(repoDescription, null, 2));
    else {
      console.log(`repo: ${repoDescription.repoRoot}`);
      console.log(`.ai1/config.json: ${repoDescription.hasAi1Config ? 'present' : 'missing (run ai1 init)'}`);
      console.log(`trunk: ${repoDescription.trunk} | knowledge: ${repoDescription.knowledge} (${repoDescription.hasKnowledgeBundle ? 'bundle found' : 'no bundle'})`);
      const { legacyMigration } = repoDescription;
      if (legacyMigration.moves.length || legacyMigration.settingsFiles.length) {
        console.log(`old layout to migrate (ai1 init does it): ${[...legacyMigration.moves.map((plannedMove) => `${plannedMove.from} -> ${plannedMove.to}`), ...legacyMigration.settingsFiles.map((settingsPath) => `${settingsPath}: jig@jig -> ai1@ai1`)].join(', ')}${legacyMigration.conflicts.length ? ` (blocked: ${legacyMigration.conflicts.join(', ')} already exist)` : ''}`);
      }
      const { worktreeRecipe } = repoDescription;
      console.log(`ai1's own errors: ${repoDescription.reportErrors || 'ask (not chosen yet; ai1 init --report-errors ask|auto|off)'}`);
      console.log(`credential deny rules: ${repoDescription.credentialDenyRules.present}/${repoDescription.credentialDenyRules.total} in .claude/settings.json${repoDescription.credentialDenyRules.present < repoDescription.credentialDenyRules.total ? ' (ai1 init --deny-credentials adds them)' : ''}`);
      console.log(`worktree recipe: ${worktreeRecipe.status}${worktreeRecipe.errors.length ? ` (${worktreeRecipe.errors.join('; ')})` : ''}${worktreeRecipe.warnings.length ? ` (${worktreeRecipe.warnings.join('; ')})` : ''}`);
      for (const featureStatus of repoDescription.features) {
        const { recommendation } = featureStatus;
        const recommendationText = recommendation.recommended === null ? 'ask' : recommendation.recommended ? 'recommended' : 'not recommended';
        console.log(`  [${featureStatus.enabled ? 'x' : ' '}] ${featureStatus.id}: ${featureStatus.title}${featureStatus.enabledByDefault ? ' (default on)' : ''} - ${recommendationText}: ${recommendation.reason}${recommendation.evidence.length ? ` (${recommendation.evidence.join('; ')})` : ''}`);
      }
      const { repoRules } = repoDescription;
      if (repoRules.active.length || repoRules.ignored.length) console.log(`repo rules: ${repoRules.active.join(', ') || 'none active'}${repoRules.ignored.map((ignoredNotice) => `\n  ${ignoredNotice}`).join('')}`);
      if (repoDescription.detectedVerifyCommands.length) console.log(`detected verify commands: ${repoDescription.detectedVerifyCommands.join(', ')}`);
      for (const overlappingPlugin of repoDescription.overlappingPlugins) {
        console.log(`plugin overlap (${overlappingPlugin.action === 'disable' ? 'disable it here with ai1 init --disable-plugins' : 'only a warning'}): ${describeOverlap(overlappingPlugin)}`);
      }
    }
  } else if (commandName === 'init') {
    if (commandArguments.includes('--knowledge')) throw new Error('--knowledge is no longer supported: the knowledge bundle is always .ai1/okf/ (ai1 init moves an existing one there)');
    const featureList = readOption('--features');
    if (featureList === undefined) throw new Error('--features is required, e.g. --features okf,danger (use --features "" for none)');
    const verifyCommands = readRepeatedOption('--verify');
    const splitList = (listText) => (listText ?? '').split(',').map((listItem) => listItem.trim()).filter(Boolean);
    const setupResult = setupRepo(repoRoot, {
      enabledFeatureIds: splitList(featureList),
      verifyCommands: verifyCommands.length ? verifyCommands : undefined,
      disabledPluginIds: splitList(readOption('--disable-plugins')),
      denyCredentials: commandArguments.includes('--deny-credentials'),
      reportErrors: readOption('--report-errors'),
    });
    if (wantsJson) console.log(JSON.stringify(setupResult, null, 2));
    else {
      const { legacyMigration } = setupResult;
      for (const plannedMove of legacyMigration.moves) console.log(`moved ${plannedMove.from} -> ${plannedMove.to}`);
      for (const settingsPath of legacyMigration.settingsFiles) console.log(`updated ${settingsPath}: jig@jig -> ai1@ai1`);
      if (legacyMigration.filesMentioningOldPaths.length) console.log(`still mention old paths (update them): ${legacyMigration.filesMentioningOldPaths.join(', ')}`);
      const migrationText = describeMigrationReports(setupResult.migrationReports);
      if (migrationText) console.log(migrationText);
      console.log(`wrote ${setupResult.ai1ConfigPath}`);
      console.log(`wrote ${setupResult.settingsPath}`);
      console.log(`features: ${Object.entries(setupResult.features).map(([featureId, isEnabled]) => `${featureId}=${isEnabled ? 'on' : 'off'}`).join(', ')}`);
      if (setupResult.disabledPlugins.length) console.log(`disabled for you in this repo (overlap with ai1), in ${setupResult.localSettingsPath}: ${setupResult.disabledPlugins.join(', ')}${setupResult.gitignoreUpdated ? ' (added to .gitignore)' : ''}`);
      if (setupResult.reportErrors) console.log(`ai1's own errors: ${setupResult.reportErrors} (env.AI1_REPORT_ERRORS in your user settings, ~/.claude/settings.json)`);
      if (setupResult.addedDenyRules.length) console.log(`added ${setupResult.addedDenyRules.length} credential deny rules to ${setupResult.settingsPath} (permissions.deny)`);
      if (setupResult.features.okf && !setupResult.hasKnowledgeBundle) console.log(`no OKF bundle at ${setupResult.knowledge}/ yet: create it with /ai1:okf-maintain-knowledge (produce mode)`);
      console.log(`Commit ${legacyMigration.moves.length ? 'the moves, ' : ''}.ai1/config.json and .claude/settings.json, then restart the Claude Code session.`);
    }
  } else if (commandName === 'verify' || commandName === 'step-done') {
    const [planSlug, stepText] = commandArguments;
    if (commandName === 'step-done' && (!planSlug || !stepText)) throw new Error('usage: ai1 step-done <slug> "<step>"');
    const verifyCommands = readVerifyCommands(repoRoot);
    const verifyResult = runVerifyCommands(repoRoot, verifyCommands);
    if (!verifyResult.passed) {
      console.error(`ai1: \`${verifyResult.failedCommand}\` failed (exit ${verifyResult.exitCode})${commandName === 'step-done' ? '; step not recorded' : ''}`);
      process.exitCode = verifyResult.exitCode || 1;
    } else if (commandName === 'step-done') {
      const planRoot = findPlanRootFor(repoRoot, planSlug);
      console.log(`ai1: verify green; step recorded in ${recordStepDone(planRoot, planSlug, stepText, verifyCommands)}`);
      try {
        const coverageLine = describeScenarioCoverage(planRoot, repoRoot, planSlug);
        if (coverageLine) console.log(`ai1: ${coverageLine}`);
      } catch (scanError) {
        console.log(`ai1: scenario coverage not checked (${scanError.message.split('\n')[0]})`);
      }
    } else {
      console.log(`ai1: verify green (${verifyCommands.join(', ')})`);
    }
  } else if (commandName === 'plan-done') {
    const [planSlug] = commandArguments;
    if (!planSlug) throw new Error('usage: ai1 plan-done <slug>');
    const closeResult = closePlan(findPlanRootFor(repoRoot, planSlug), repoRoot, planSlug, readVerifyCommands(repoRoot));
    if (closeResult.closed) console.log(`ai1: ${closeResult.message}`);
    else { console.error(`ai1: plan not closed - ${closeResult.message}`); process.exitCode = 1; }
  } else if (commandName === 'claude-md') {
    const bundleDirectory = resolveBundleDirectory(repoRoot);
    if (readBundleIndex(bundleDirectory) === null) throw new Error(`no OKF bundle at ${KNOWLEDGE_BUNDLE_PATH}/: nothing to compare CLAUDE.md with`);
    const claudeMdReports = checkClaudeMdFiles(repoRoot, bundleDirectory, buildFileMap(bundleDirectory, KNOWLEDGE_BUNDLE_PATH));
    console.log(wantsJson ? JSON.stringify(claudeMdReports, null, 2) : formatClaudeMdReport(claudeMdReports));
  } else if (commandName === 'log') {
    const sinceHours = readOption('--since') === undefined ? undefined : Number(readOption('--since'));
    console.log(runLogCommand(findMainCheckout(repoRoot), { sessionId: readOption('--session'), sinceHours, wantsJson, allRepos: commandArguments.includes('--all') }));
  } else if (commandName === 'fork') {
    process.exitCode = runForkCommand(repoRoot, commandArguments, { readOption });
  } else if (commandName === 'issue') {
    process.exitCode = runIssueCommand(repoRoot, commandArguments, { readOption });
  } else if (commandName === 'later') {
    process.exitCode = runLaterCommand(repoRoot, commandArguments, { readOption });
  } else if (commandName === 'storyboard') {
    process.exitCode = runStoryboardCommand(repoRoot, commandArguments, { readOption });
  } else {
    console.log(`usage: ai1 status [--json] | ai1 init --features okf,danger [--verify "<command>" ...] [--disable-plugins a@x,b@y] [--deny-credentials] [--report-errors ask|auto|off] [--json] | ai1 verify | ai1 step-done <slug> "<step>" | ai1 plan-done <slug> | ai1 claude-md [--json] | ai1 log [--session <id>] [--since <hours>] [--all] [--json] | ${LATER_USAGE}`);
    console.log(WORKTREE_USAGE);
    console.log(FORK_USAGE);
    console.log(ISSUE_USAGE);
    console.log(SKILL_CONTEXT_USAGE);
    console.log(STORYBOARD_USAGE);
    process.exitCode = commandName ? 1 : 0;
  }
} catch (commandError) {
  console.error(`ai1: ${commandError.message}`);
  process.exitCode = 1;
}
