#!/usr/bin/env node
// jig CLI. On the Bash PATH while the plugin is enabled.
//   jig status [--json]                         what this repo runs, and the available features
//   jig init --features okf,danger [--verify "npm test" ...] [--knowledge .okf] [--json]
//   jig verify                                  run the repo's verify commands, stop at the first failure
//   jig step-done <slug> "<step>"               jig verify, then log the step in .jig/work/<slug>/progress.md
// Run from anywhere inside the repo; files are written at the repo root.

import { findRepoRoot, describeRepo, setupRepo } from '../src/cli/setup-repo.mjs';
import { readVerifyCommands, runVerifyCommands, recordStepDone } from '../src/cli/verify-run.mjs';

const [commandName, ...commandArguments] = process.argv.slice(2);

function readOption(optionName) {
  const optionIndex = commandArguments.indexOf(optionName);
  return optionIndex >= 0 ? commandArguments[optionIndex + 1] : undefined;
}

function readRepeatedOption(optionName) {
  const optionValues = [];
  commandArguments.forEach((commandArgument, argumentIndex) => {
    if (commandArgument === optionName && commandArguments[argumentIndex + 1] !== undefined) optionValues.push(commandArguments[argumentIndex + 1]);
  });
  return optionValues;
}

const wantsJson = commandArguments.includes('--json');
const repoRoot = findRepoRoot(process.cwd());

try {
  if (commandName === 'status') {
    const repoDescription = describeRepo(repoRoot);
    if (wantsJson) console.log(JSON.stringify(repoDescription, null, 2));
    else {
      console.log(`repo: ${repoDescription.repoRoot}`);
      console.log(`jig.json: ${repoDescription.hasJigConfig ? 'present' : 'missing (run jig init)'}`);
      console.log(`trunk: ${repoDescription.trunk} | knowledge: ${repoDescription.knowledge} (${repoDescription.hasKnowledgeBundle ? 'bundle found' : 'no bundle'})`);
      for (const featureStatus of repoDescription.features) {
        console.log(`  [${featureStatus.enabled ? 'x' : ' '}] ${featureStatus.id}: ${featureStatus.title}${featureStatus.enabledByDefault ? ' (default on)' : ''}`);
      }
    }
  } else if (commandName === 'init') {
    const featureList = readOption('--features');
    if (featureList === undefined) throw new Error('--features is required, e.g. --features okf,danger (use --features "" for none)');
    const verifyCommands = readRepeatedOption('--verify');
    const setupResult = setupRepo(repoRoot, {
      enabledFeatureIds: featureList.split(',').map((featureId) => featureId.trim()).filter(Boolean),
      verifyCommands: verifyCommands.length ? verifyCommands : undefined,
      knowledgePath: readOption('--knowledge'),
    });
    if (wantsJson) console.log(JSON.stringify(setupResult, null, 2));
    else {
      console.log(`wrote ${setupResult.jigConfigPath}`);
      console.log(`wrote ${setupResult.settingsPath}`);
      console.log(`features: ${Object.entries(setupResult.features).map(([featureId, isEnabled]) => `${featureId}=${isEnabled ? 'on' : 'off'}`).join(', ')}`);
      if (setupResult.disabledPlugins.length) console.log(`disabled for you in this repo (duplicate OKF skills), in ${setupResult.localSettingsPath}: ${setupResult.disabledPlugins.join(', ')}${setupResult.gitignoreUpdated ? ' (added to .gitignore)' : ''}`);
      if (setupResult.features.okf && !setupResult.hasKnowledgeBundle) console.log(`no OKF bundle at ${setupResult.knowledge}/ yet: create it with /jig:okf (produce mode)`);
      console.log('Commit .claude/jig.json and .claude/settings.json, then restart the Claude Code session.');
    }
  } else if (commandName === 'verify' || commandName === 'step-done') {
    const [planSlug, stepText] = commandArguments;
    if (commandName === 'step-done' && (!planSlug || !stepText)) throw new Error('usage: jig step-done <slug> "<step>"');
    const verifyCommands = readVerifyCommands(repoRoot);
    const verifyResult = runVerifyCommands(repoRoot, verifyCommands);
    if (!verifyResult.passed) {
      console.error(`jig: \`${verifyResult.failedCommand}\` failed (exit ${verifyResult.exitCode})${commandName === 'step-done' ? '; step not recorded' : ''}`);
      process.exitCode = verifyResult.exitCode || 1;
    } else if (commandName === 'step-done') {
      console.log(`jig: verify green; step recorded in ${recordStepDone(repoRoot, planSlug, stepText, verifyCommands)}`);
    } else {
      console.log(`jig: verify green (${verifyCommands.join(', ')})`);
    }
  } else {
    console.log('usage: jig status [--json] | jig init --features okf,danger [--verify "<command>" ...] [--knowledge <path>] [--json] | jig verify | jig step-done <slug> "<step>"');
    process.exitCode = commandName ? 1 : 0;
  }
} catch (commandError) {
  console.error(`jig: ${commandError.message}`);
  process.exitCode = 1;
}
